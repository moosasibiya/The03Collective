generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model VehicleEnquiry {
  id          String   @id @default(cuid())
  vehicleSlug String
  vehicleName String
  name        String
  phone       String
  email       String?
  message     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([vehicleSlug])
  @@index([createdAt])
  @@map("vehicle_enquiries")
}

model ConsignmentLead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  make      String
  model     String
  year      String?
  mileage   String?
  price     String?
  notes     String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("consignment_leads")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  type      String?
  message   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}