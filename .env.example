# ====================================================
# THE 03 COLLECTIVE - Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit your real environment file to git
# ====================================================

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Database
# Use the pooled connection string for runtime traffic.
DATABASE_URL=

# Use the direct connection string for Prisma migrations and db push.
DIRECT_URL=

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
RESEND_API_KEY=

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Business configuration
BUSINESS_EMAIL=hello@the03collective.co.za
NEXT_PUBLIC_BUSINESS_WHATSAPP=27820000000
NEXT_PUBLIC_BUSINESS_PHONE=+27 82 000 0000
NEXT_PUBLIC_BUSINESS_EMAIL=hello@the03collective.co.za

# Public social links
NEXT_PUBLIC_INSTAGRAM_HANDLE=@the03collective
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/the03collective
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/the03collective
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@the03collective

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://www.the03collective.co.za

# Optional: enable embedded Sanity Studio on the live site.
SANITY_STUDIO_ENABLED=false
