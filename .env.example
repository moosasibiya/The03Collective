# ════════════════════════════════════════════════════
# THE 03 COLLECTIVE — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git
# ════════════════════════════════════════════════════

# ── Sanity CMS ──────────────────────────────────────
# Project ID from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name (production / staging)
NEXT_PUBLIC_SANITY_DATASET=production

# Read-only API token (Viewer role) from sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=

# ── Supabase / Database ─────────────────────────────
# Pooled connection string — used at runtime (port 6543)
# Found in Supabase → Settings → Database → Connection Pooling
DATABASE_URL=

# Direct connection string — used by Prisma for migrations (port 5432)
# Found in Supabase → Settings → Database → Direct Connection
DIRECT_URL=

# ── Resend (Email) ──────────────────────────────────
# API key from resend.com → API Keys
RESEND_API_KEY=

# ── Sentry (Error Tracking) ─────────────────────────
# DSN from sentry.io → your project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# Org slug from sentry.io (used in next.config.ts for source map upload)
SENTRY_ORG=

# Project slug from sentry.io
SENTRY_PROJECT=

# Auth token for source map upload — sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=

# ── Business Configuration ──────────────────────────
# Email address that receives all enquiry and form notifications
BUSINESS_EMAIL=hello@the03collective.co.za

# WhatsApp number in international format — no + prefix, no spaces
NEXT_PUBLIC_BUSINESS_WHATSAPP=27820000000

# Production URL — no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.the03collective.co.za
